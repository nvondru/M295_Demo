{
  "info": {
    "name": "M295 Demo API",
    "description": "Alle Requests der M295 Demo API (Users, Subjects, Grades).\n\nDie \"erstellen\"-Requests speichern die neue ID automatisch in `userId`, `subjectId` und `gradeId`. Darum am besten von oben nach unten ausführen.\n\nBei den Requests mit Bild-Upload muss im Body beim Feld `image` zuerst eine Datei ausgewählt werden.\n\nDer Ordner \"Aufräumen\" löscht alles wieder, darum steht er am Schluss.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Users",
      "description": "CRUD für Benutzer: /users",
      "item": [
        {
          "name": "Alle Benutzer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Gibt alle Benutzer zurück (ohne Passwort)."
          }
        },
        {
          "name": "Benutzer erstellen",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"userId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Erstellt einen Benutzer. Die neue ID wird in der Variable `userId` gespeichert.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Anna\",\n  \"password\": \"geheim\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Benutzer anzeigen",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            },
            "description": "Gibt den Benutzer mit der ID `userId` zurück."
          }
        },
        {
          "name": "Benutzer ändern",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            },
            "description": "Ändert Benutzername und Passwort.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Anna Muster\",\n  \"password\": \"neuesPasswort\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
