          "name": "Fach erstellen (mit Bild)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"subjectId\", pm.response.json().id);",
                  "if (pm.response.code === 201) console.log(\"Bild ansehen: \" + pm.collectionVariables.get(\"baseUrl\") + \"/uploads/\" + pm.response.json().imagePath);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/subjects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subjects"
              ]
            },
            "description": "Erstellt ein Fach als `multipart/form-data`.\n\n**Vor dem Senden:** beim Feld `image` eine Bilddatei auswählen.\n\nDie neue ID wird in `subjectId` gespeichert.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Mathematik",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Algebra und Geometrie",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Bild (PNG/JPG, max. 2 MB) hier auswählen"
                }
              ]
            }
          }
        },
        {
          "name": "Fach anzeigen",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/subjects/{{subjectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subjects",
                "{{subjectId}}"
              ]
            },
            "description": "Gibt das Fach zurück. Das Bild ist im Browser unter `{{baseUrl}}/uploads/<imagePath>` sichtbar."
          }
        },
